  "redirects": [
    {
      "source": "/home/how-it-works",
      "destination": "/guides/monitoring/overview",
      "permanent": true
    },
    {
      "source": "/home/glossary",
      "destination": "/glossary",
      "permanent": true
    },
    {
      "source": "/api-reference/errors",
      "destination": "/developers/errors",
      "permanent": true
    },
    {
      "source": "/api-reference/pagination",
      "destination": "/developers/pagination",
      "permanent": true
    }
